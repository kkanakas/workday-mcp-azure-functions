{
  "IsEncrypted": false,
  "Values": {
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",
    "FUNCTIONS_WORKER_RUNTIME": "python",
    "ENTRA_TENANT_ID": "<entra-tenant-id>",
    "_comment_ENTRA_API_AUDIENCE": "Expected 'aud' claim of inbound tokens. The app is registered with requestedAccessTokenVersion=2 (see scripts/register-entra-apps.sh), and v2 access tokens carry the app's Client ID GUID as 'aud' - NOT the api:// Application ID URI. Set this to the same GUID as ENTRA_CLIENT_ID.",
    "ENTRA_API_AUDIENCE": "<workday-mcp-api-app-client-id>",
    "ENTRA_API_SCOPE": "api://<workday-mcp-api-app-client-id>/access_as_user",
    "ENTRA_CLIENT_ID": "<workday-mcp-api-app-client-id>",
    "ENTRA_CLIENT_SECRET": "<workday-mcp-api-app-client-secret>",
    "MCP_RESOURCE_URL": "http://localhost:7071/mcp",
    "_comment_MCP_ALLOWED_HOSTS": "Optional comma-separated Host header allow-list for the MCP transport's DNS-rebinding protection. Defaults to the host of MCP_RESOURCE_URL plus loopback addresses.",
    "WORKDAY_TENANT_BASE_URL": "https://<workday-host>/ccx/api/v1/<workday-tenant>",
    "WORKDAY_TOKEN_URL": "https://<workday-host>/ccx/oauth2/<workday-tenant>/token",
    "WORKDAY_CLIENT_ID": "<workday-isu-client-id>",
    "WORKDAY_CLIENT_SECRET": "<workday-isu-client-secret>",
    "DEV_SKIP_AUTH": "true"
  }
}
